<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <Mantle.KitDef>
    <defName>TestKitWallNotWall</defName>
    <label>TestKitWallNotWall</label>
    <nameMaker>NamerSettlementTribal</nameMaker>
    <skeleton>
      <parts>
        <li><name>core</name><kind>Core</kind></li>
        <li><name>gate</name><kind>Gate</kind></li>
        <li><name>walls</name><kind>WallLine</kind><optional>true</optional></li>
      </parts>
